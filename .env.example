# ============================================
#   SAM AGENT SYSTEM — ENVIRONMENT VARIABLES
#   Copy this to .env and fill in your values
# ============================================

# --- AGENT A: Google Maps Scraping ---
# Get free token at: https://apify.com (free tier = 5 runs/month)
APIFY_TOKEN=your_apify_token_here

# --- AGENT C: Website Generation ---
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- AGENT D: GitHub ---
# Get token at: https://github.com/settings/tokens (repo scope)
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_USERNAME=your_github_username
GITHUB_REPO=indian-client-websites

# --- AGENT D: Vercel ---
# Get token at: https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token_here

# --- AGENT E: Twilio WhatsApp ---
# Sign up free at: https://twilio.com (free sandbox included)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# YOUR WhatsApp number (with country code, no spaces)
YOUR_WHATSAPP=whatsapp:+91XXXXXXXXXX

# --- AGENT E: Gmail ---
# Use Gmail App Password (not your real password)
# Enable at: myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_PASSWORD=your_gmail_app_password_here

# --- AGENT E: Booking ---
# Your Calendly or Google Meet scheduling link
BOOKING_LINK=https://calendly.com/your_link
